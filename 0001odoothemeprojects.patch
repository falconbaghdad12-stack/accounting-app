+def project_profitability(project_id, date_from=None, date_to=None):
+    """يرجع (إجمالي الإيراد, إجمالي التكلفة, صافي ربح/خسارة المشروع, تفاصيل الحركات)"""
+    df = project_transactions_df(project_id, date_from, date_to)
+    if df.empty:
