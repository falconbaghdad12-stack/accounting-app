+    total_revenue = float((revenue_rows["دائن"] - revenue_rows["مدين"]).sum())
+    total_cost = float((cost_rows["مدين"] - cost_rows["دائن"]).sum())
+    net_profit = total_revenue - total_cost
+    return total_revenue, total_cost, net_profit, df
